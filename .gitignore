# Rust build output.
target/
# Runtime loop state + results logs.
/workspace/
/state/
*.log
# Example domains: the engine creates a workspace + state under each example's manifest dir.
examples/*/workspace/
examples/*/state/
# Python noise.
__pycache__/
*.pyc
.venv/
# mdBook render output.
/book/
# Operator steer scratch (consumed at runtime).
/STEER.md
# macOS Finder droppings.
.DS_Store
# Live example variants (real-model smokes) keep their own workspace dir.
examples/*/workspace-*/
# Local MCP server wiring (machine-specific endpoints, tokens pulled at launch).
/.mcp.json
# Run scratch pulled down for analysis, never an input to anything here.
/run*-session.jsonl
/run*.diff
/mergetest/
.govctl.lock
.govctl/

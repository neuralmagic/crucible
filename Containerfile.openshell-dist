# produces: ghcr.io/neuralmagic/openshell-gateway:sha-<rev>
# A pure distribution image for the OpenShell gateway + CLI built from the fork rev pinned in
# Cargo.lock (openshell-core's git source). Never run directly — the loop images
# (Containerfile.crucible*) `COPY --from=` it, so `FROM scratch` is enough. Both binaries come
# from ONE rev, the same rev crucible's gRPC client compiled against, so client/gateway/CLI
# skew is impossible by construction (crucible additionally gates the version at runtime).
#
# Built and pushed by .github/workflows/openshell-gateway.yml, which stages the release
# binaries into bin/ (glibc, bundled-z3 — self-contained on the UBI10 loop base) and uses
# that staging dir as the build context.
FROM scratch
COPY openshell-gateway openshell /usr/local/bin/

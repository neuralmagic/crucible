+/// [`render_with_hover`], with every hover group passed through `decorate` with the node or edge
+/// it is over, so an app can make them pressable or give them help. A node with no edges gets a
+/// hover group too.
+pub fn render_with(src: &str, style: &DiagramStyle, hover: Hover, color: Color, decorate: &dyn Fn(&Target, El) -> El) -> Option<El> {
+    let hover = (hover != Hover::Off).then_some((hover, color));
+    scenes::built(src, style, hover, None).0.map(|s| s.el_with(style, false, decorate))
+}

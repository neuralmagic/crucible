+#[test]
+fn every_node_and_edge_spot_names_what_it_is_over() {
+    let s = lit_scene("flowchart TD\n  A --> B\n  C");
+    let node = |id: &str| spots(&s, &format!("hover:n:{id}")).map(|h| h.target.clone()).collect::<Vec<_>>();
+    assert_eq!(node("A"), [Target::Node("A".into())]);
+    assert_eq!(node("B"), [Target::Node("B".into())]);
+    assert_eq!(node("C"), [Target::Node("C".into())], "a node with no edges is a hover target too");
+    let edges: Vec<&Spot> = spots(&s, "hover:e:").collect();
+    assert!(!edges.is_empty());
+    assert!(edges.iter().all(|h| h.target == Target::Edge { from: "A".into(), to: "B".into() }));
+}
+
+#[test]
+fn render_with_passes_every_spot_through_decorate() {
+    fn view(_: &u32, _: &mut Cx<u32>) -> El {
+        let decorate = |t: &Target, spot: El| match t {
+            Target::Node(id) => el().key(format!("pick:{id}")).child(spot),
+            Target::Edge { .. } => spot,
+        };
+        col().w_full().child(crate::render_with("flowchart LR\n  A --> B\n  C", &DiagramStyle::neutral(false), Hover::Edges, LIT, &decorate).expect("draws"))
+    }
+    let mut rt = Runtime::new(0u32, view, (400.0, 400.0), Env::new(false, 1.0));
+    rt.frame(0.0);
+    let keys: Vec<String> = rt.elements().into_iter().filter_map(|e| e.key).filter(|k| k.starts_with("pick:")).collect();
+    for id in ["A", "B", "C"] {
+        assert!(keys.iter().any(|k| k == &format!("pick:{id}")), "{id} decorated: {keys:?}");
+    }
+}
+
+#[test]
+fn a_decorated_node_or_edge_takes_a_press() {
+    fn view(_: &String, _: &mut Cx<String>) -> El {
+        let decorate = |t: &Target, spot: El| {
+            let said = match t {
+                Target::Node(id) => id.clone(),
+                Target::Edge { from, to } => format!("{from}>{to}"),
+            };
+            spot.on_press(move |s: &mut String| *s = said.clone())
+        };
+        col().w_full().child(crate::render_with("flowchart TD\n  A --> B", &DiagramStyle::neutral(false), Hover::Edges, LIT, &decorate).expect("draws"))
+    }
+    let mut rt = Runtime::new(String::new(), view, (400.0, 600.0), Env::new(false, 1.0));
+    rt.frame(0.0);
+    for (key, said) in [("hover:n:B", "B"), ("hover:e:A>B.0", "A>B")] {
+        let r = rt.elements().into_iter().find(|e| e.key.as_deref() == Some(key)).unwrap_or_else(|| panic!("no {key}")).rect;
+        let (x, y) = (r[0] + r[2] / 2.0, r[1] + r[3] / 2.0);
+        rt.pointer_move(x, y);
+        rt.frame(0.1);
+        rt.pointer_down(x, y);
+        rt.pointer_up(x, y);
+        rt.frame(0.2);
+        let mut now = String::new();
+        rt.update(|s, _| now = s.clone());
+        assert_eq!(now, said, "{key} at {r:?}");
+    }
+}

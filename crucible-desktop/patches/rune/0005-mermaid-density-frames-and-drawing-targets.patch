+
+#[test]
+fn node_padding_and_gaps_shrink_a_flowchart_and_key_its_scene() {
+    let src = "flowchart TD\n  A[first] --> B[second]\n  subgraph G\n    B\n    C[third]\n  end";
+    let roomy = DiagramStyle::neutral(false);
+    let mut tight = DiagramStyle::neutral(false);
+    tight.node_pad = [10.0, 4.0];
+    tight.flow_gaps = [10.0, 16.0, 6.0];
+    let size = |style: &DiagramStyle| crate::render_drawing(src, style, crate::Hover::Off, style.text).expect("draws").size;
+    let (a, b) = (size(&roomy), size(&tight));
+    assert!(b[0] < a[0] && b[1] < a[1], "{a:?} -> {b:?}");
+    // The same source under another padding is another scene, not the cached one.
+    assert_eq!(size(&roomy), a);
+    assert_eq!(padded_node_size(NodeShape::Rect, [80.0, 18.0], crate::shape::PAD), crate::shape::node_size(NodeShape::Rect, [80.0, 18.0]));
+    assert_eq!(padded_node_size(NodeShape::Rect, [80.0, 18.0], [10.0, 4.0]), [90.0, 22.0]);
+}

+    /// Each label's box in the drawing [`Self::drawing`] returns: `[x, y, w, h]` from its top left.
+    pub(crate) fn label_rects(&self, paint: &DiagramStyle) -> Vec<[f32; 4]> {
+        let mut origin = [0.0, 0.0];
+        if let Some(title) = &self.title {
+            let t = measure(title, title_font(paint)).size;
+            origin = [(t[0] + 2.0 - self.size[0]).max(0.0) / 2.0, t[1] + TITLE_GAP];
+        }
+        let k = self.scale;
+        self.labels.iter().map(|l| [origin[0] + l.at[0] * k, origin[1] + l.at[1] * k, l.size[0] * k, l.size[1] * k]).collect()
+    }
+
     fn title_el(&self, paint: &DiagramStyle, streaming: bool, marks: Marks<'_>) -> Option<El> {
         let still = if streaming { Transition::opacity() } else { Transition::none() };
         self.title.as_ref().map(|title| marked(text(title.clone()).key("title").font(title_font(paint)).color(paint.text).transition(still), "title", marks))

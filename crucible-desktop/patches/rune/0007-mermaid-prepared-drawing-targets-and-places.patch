diff --git a/crates/rune-mermaid/src/canvas/hover_tests.rs b/crates/rune-mermaid/src/canvas/hover_tests.rs
index f5e96e96..1923e4d7 100644
--- a/crates/rune-mermaid/src/canvas/hover_tests.rs
+++ b/crates/rune-mermaid/src/canvas/hover_tests.rs
@@ -252,3 +252,39 @@ fn a_decorated_node_or_edge_takes_a_press() {
         assert_eq!(now, said, "{key} at {r:?}");
     }
 }
+
+#[test]
+fn a_prepared_drawing_decorates_its_spots_and_says_where_its_labels_are() {
+    let style = DiagramStyle::neutral(false);
+    let src = "flowchart TD\n  A[first] --> B[second]";
+    let model = crate::prepare_drawing(src, &style, Hover::Edges, LIT).expect("draws");
+    let labels: Vec<(&str, &str)> = model.labels().collect();
+    let places: Vec<(&str, [f32; 4])> = model.places().collect();
+    assert_eq!(labels.iter().map(|l| l.1).collect::<Vec<_>>(), ["first", "second"]);
+    assert_eq!(places.iter().map(|p| p.0).collect::<Vec<_>>(), labels.iter().map(|l| l.0).collect::<Vec<_>>());
+    let size = model.draw(|_| Vec::new()).size;
+    for (key, [x, y, w, h]) in &places {
+        assert!(*x >= 0.0 && *y >= 0.0 && x + w <= size[0] && y + h <= size[1], "{key} at {x},{y} {w}x{h} in {size:?}");
+    }
+    assert!(places[1].1[1] > places[0].1[1] + places[0].1[3], "second is under first: {places:?}");
+
+    let titled = format!("---\ntitle: Both\n---\n{src}");
+    let under = crate::prepare_drawing(&titled, &style, Hover::Edges, LIT).expect("draws");
+    let moved: Vec<(&str, [f32; 4])> = under.places().collect();
+    assert_eq!(moved.len(), 2, "the title has no place");
+    assert!(moved[0].1[1] > places[0].1[1], "a title pushes the labels down: {moved:?}");
+
+    fn view(_: &u32, _: &mut Cx<u32>) -> El {
+        let style = DiagramStyle::neutral(false);
+        let model = crate::prepare_drawing("flowchart TD\n  A[first] --> B[second]", &style, Hover::Edges, LIT).expect("draws");
+        let decorate = |t: &Target, spot: El| match t {
+            Target::Node(id) => el().key(format!("pick:{id}")).child(spot),
+            Target::Edge { .. } | Target::Frame(_) => spot,
+        };
+        col().w_full().child(model.draw_with(|_| Vec::new(), &decorate).el)
+    }
+    let mut rt = Runtime::new(0u32, view, (400.0, 400.0), Env::new(false, 1.0));
+    rt.frame(0.0);
+    let keys: Vec<String> = rt.elements().into_iter().filter_map(|e| e.key).filter(|k| k.starts_with("pick:")).collect();
+    assert_eq!(keys.len(), 2, "{keys:?}");
+}

diff --git a/crates/rune/src/zoom.rs b/crates/rune/src/zoom.rs
new file mode 100644
index 0000000..fa372d4
--- /dev/null
+++ b/crates/rune/src/zoom.rs
@@ -0,0 +1,43 @@
+//! An app-wide zoom: how many display points one layout point covers. Below 1 fits more of the
+//! app on screen, above 1 enlarges it. Layout, drawing and pointer input all go through it, so a
+//! zoomed window lays out at its zoomed size rather than scaling a bitmap.
+
+use std::sync::atomic::{AtomicU32, Ordering};
+
+static ZOOM: AtomicU32 = AtomicU32::new(0x3F80_0000);
+
+/// The smallest and largest zoom `set` keeps.
+pub const RANGE: (f32, f32) = (0.5, 2.0);
+
+/// Zoom every window to `zoom`, clamped to [`RANGE`]; windows take it on their next frame.
+pub fn set(zoom: f32) {
+    let zoom = if zoom.is_finite() { zoom.clamp(RANGE.0, RANGE.1) } else { 1.0 };
+    ZOOM.store(zoom.to_bits(), Ordering::Relaxed);
+}
+
+/// The zoom windows lay out at.
+pub fn get() -> f32 {
+    f32::from_bits(ZOOM.load(Ordering::Relaxed))
+}
+
+/// The scale a window lays out and takes input at: its display's, times the zoom.
+pub(crate) fn content_scale(window: &winit::window::Window) -> f32 {
+    window.scale_factor() as f32 * get()
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::zoom::{RANGE, get, set};
+
+    #[test]
+    fn zoom_clamps_to_its_range_and_refuses_nonsense() {
+        set(0.8);
+        assert_eq!(get(), 0.8);
+        set(0.1);
+        assert_eq!(get(), RANGE.0);
+        set(9.0);
+        assert_eq!(get(), RANGE.1);
+        set(f32::NAN);
+        assert_eq!(get(), 1.0);
+    }
+}

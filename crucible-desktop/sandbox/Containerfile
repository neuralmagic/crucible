# produces: localhost/crucible-agent
# The default image a drafting agent runs in: Claude Code as a non-root user that owns the
# working directory, which the OpenShell gateway requires. iproute2 is for its network namespace.
FROM node:22-bookworm-slim

ARG CLAUDE_VERSION=2.1.322

RUN apt-get update && apt-get install -y --no-install-recommends iproute2 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "@anthropic-ai/claude-code@${CLAUDE_VERSION}" \
    && useradd -m -s /bin/bash sandbox \
    && mkdir -p /workspace && chown sandbox:sandbox /workspace

USER sandbox
WORKDIR /workspace
CMD ["sleep", "infinity"]

{
  "name": "crucible-controller-ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun run generate",
    "dev": "vite",
    "prebuild": "bun run generate",
    "build": "tsc --noEmit && vite build",
    "precheck": "bun run generate",
    "check": "tsc --noEmit && eslint . --max-warnings 0",
    "preview": "vite preview",
    "generate": "bun run generate:spec && bun run generate:types",
    "generate:spec": "cargo run -q -p crucible-controller --features autoresearch --bin openapi-spec > openapi.json",
    "generate:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "pretest": "bun run generate",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@cedar-policy/cedar-wasm": "^4.14.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/red-hat-display": "^5.3.0",
    "@fontsource/red-hat-mono": "^5.3.0",
    "@fontsource/red-hat-text": "^5.3.0",
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@monaco-editor/react": "4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@xyflow/react": "12.12.0",
    "cmdk": "1.1.1",
    "echarts": "^6.1.0",
    "monaco-editor": "0.57.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.14.8",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

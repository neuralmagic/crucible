{
  "name": "crucible-controller-ui",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun run generate",
    "dev": "vite",
    "prebuild": "bun run generate",
    "build": "tsc --noEmit && vite build",
    "precheck": "bun run generate",
    "check": "tsc --noEmit && eslint . --max-warnings 0",
    "preview": "vite preview",
    "generate": "bun run generate:spec && bun run generate:types",
    "generate:spec": "cargo run -q -p crucible-controller --features autoresearch --bin openapi-spec > openapi.json",
    "generate:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "pretest": "bun run generate",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@fontsource/public-sans": "^5.3.0",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@monaco-editor/react": "4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^9.1.2",
    "@xyflow/react": "12.11.3",
    "echarts": "^6.1.0",
    "monaco-editor": "0.56.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.12.3",
    "react-router-dom": "^7.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@webgpu/types": "^0.1.72",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^4.1.9"
  }
}

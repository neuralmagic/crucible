{
  "realm": "crucible",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "offlineSessionIdleTimeout": 2592000,
  "groups": [
    {
      "name": "platform-devs"
    },
    {
      "name": "other-team"
    }
  ],
  "clients": [
    {
      "clientId": "crucible-controller",
      "name": "the relying party (the controller's browser flow)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "controller-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "crucible-cli",
      "name": "the public device-flow client (bearer JWTs)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "crucible-cli-brief",
      "name": "the same public client with a one-second access token, for the expiry test",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.lifespan": "1"
      }
    },
    {
      "clientId": "other-app",
      "name": "a different application on the same realm",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "crucible-controller-roles",
      "name": "crucible-controller-roles",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "controller-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Anderson",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ],
      "groups": [
        "/platform-devs"
      ],
      "realmRoles": [
        "offline_access"
      ]
    },
    {
      "username": "mallory",
      "enabled": true,
      "emailVerified": true,
      "email": "mallory@example.com",
      "firstName": "Mallory",
      "lastName": "Mallory",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "mallory-password",
          "temporary": false
        }
      ],
      "groups": [
        "/other-team"
      ],
      "realmRoles": [
        "offline_access"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "the offline credential a scheduled launch re-checks group membership with"
      }
    ]
  }
}

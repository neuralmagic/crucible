# Minimal loop image for the kind e2e: the engine plus what a command-only playbook pod runs, and
# tools/fake-agent.py for packs whose agent is the command backend with no model.
ARG BASE=ubuntu:24.04
FROM ${BASE}
ARG CONTRACT_VERSION=unset--pass-build-arg-CONTRACT_VERSION-from-crucible-binary
ARG CONTRACT_LABEL=${CONTRACT_VERSION}
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends git ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*
COPY crucible /usr/local/bin/crucible
COPY fake-agent.py /usr/local/share/fake-agent/fake-agent.py
RUN test "$(crucible --contract-version)" = "${CONTRACT_VERSION}"
LABEL io.crucible.contract-version="${CONTRACT_LABEL}"

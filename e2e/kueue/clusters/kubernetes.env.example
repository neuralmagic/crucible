# Values for `just kueue-e2e-cluster <name>` on a plain Kubernetes cluster. Copy to <name>.env
# (ignored by git) and fill in. Any value the script header lists may also be set here.
CONTEXT=<kube context>
PULL_SECRET=<crucible-system pull Secret that may also push to PUSH_REPO>
PUSH_REPO=<registry/path the pack pushes to>
ANTHROPIC_BASE_URL=<Anthropic Messages API endpoint>
# A local file holding the key, loaded into the e2e's own Secret; or ANTHROPIC_KEY_SECRET.
ANTHROPIC_KEY_FILE=<path to a file holding the API key>
CLUSTER_QUEUE=<the ClusterQueue the e2e LocalQueue points at>

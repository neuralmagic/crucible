# Values for `just kueue-e2e-cluster <name>` on an OpenShift cluster. Copy to <name>.env (ignored
# by git) and fill in. Any value the script header lists may also be set here.
CONTEXT=<kube context>
PULL_SECRET=<crucible-system pull Secret that may also push to PUSH_REPO>
PUSH_REPO=<registry/path the pack pushes to>
ANTHROPIC_BASE_URL=<Anthropic Messages API endpoint>
ANTHROPIC_KEY_SECRET=<crucible-system Secret holding its api-key>
SANDBOX_SCC_ROLE=<ClusterRole granting the sandbox account its SCC>
LOOP_SCC_ROLE=<ClusterRole granting the loop and builder accounts their SCC>

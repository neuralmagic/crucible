{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT DISTINCT s.issue AS \"issue!\", c.pr_url AS \"pr_url!\"\n        FROM candidates c\n        JOIN runs r ON r.run_id = c.run_id\n        JOIN scopes s ON s.id = r.scope\n        WHERE c.pr_url IS NOT NULL AND c.decision = 'keep'\n        ORDER BY s.issue, c.pr_url\n        ",

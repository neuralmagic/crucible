  "query": "\n        SELECT r.run_id AS \"run_id!\", r.scope, r.session_uri, r.pod\n        FROM runs r\n        WHERE r.issue = $1 AND r.status = 'running'\n        ORDER BY r.seq DESC LIMIT 1\n        ",

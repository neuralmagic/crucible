{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:def|if|elif|else|for)\\b.*:\\s*(?:#.*)?$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*(?:pass|return|break|continue)\\b.*$",
      "action": { "indent": "outdent" }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}

@@ -0,0 +1,146 @@
+//! The app's Dock tile: a badge label, and a progress bar drawn over the app's icon.
+//!
+//! Call these on the main thread (from `poll` or a handle update). Off macOS they do nothing.
+
+/// Shows `label` as the Dock icon's badge, or clears the badge with `None` or an empty label.
+#[cfg_attr(not(target_os = "macos"), allow(unused_variables))]
+pub fn set_badge(label: Option<&str>) {
+    #[cfg(target_os = "macos")]
+    mac::set_badge(label.filter(|l| !l.is_empty()));
+}
+
+/// Draws a progress bar across the bottom of the Dock icon, filled to `fraction` (clamped to
+/// 0..=1), or puts the plain icon back with `None`.
+#[cfg_attr(not(target_os = "macos"), allow(unused_variables))]
+pub fn set_progress(fraction: Option<f64>) {
+    #[cfg(target_os = "macos")]
+    mac::set_progress(fraction.map(clamp));
+}
+
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+fn clamp(fraction: f64) -> f64 {
+    if fraction.is_nan() { 0.0 } else { fraction.clamp(0.0, 1.0) }
+}
+
+/// The bar's track and fill, as `[x, y, width, height]` in a square icon `side` points wide with
+/// its origin at the bottom left.
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+fn bar(side: f64, fraction: f64) -> ([f64; 4], [f64; 4]) {
+    let inset = side * 0.12;
+    let height = side * 0.1;
+    let y = side * 0.08;
+    let width = side - 2.0 * inset;
+    ([inset, y, width, height], [inset, y, width * clamp(fraction), height])
+}
+
+#[cfg(target_os = "macos")]
+mod mac {
+    use objc2::runtime::AnyObject;
+    use objc2::{Encode, Encoding, class, msg_send};
+
+    #[repr(C)]
+    #[derive(Clone, Copy)]
+    struct Size {
+        w: f64,
+        h: f64,
+    }
+
+    // SAFETY: two doubles, laid out as CGSize.
+    unsafe impl Encode for Size {
+        const ENCODING: Encoding = Encoding::Struct("CGSize", &[f64::ENCODING, f64::ENCODING]);
+    }
+
+    #[repr(C)]
+    #[derive(Clone, Copy)]
+    struct Point {
+        x: f64,
+        y: f64,
+    }
+
+    // SAFETY: two doubles, laid out as CGPoint.
+    unsafe impl Encode for Point {
+        const ENCODING: Encoding = Encoding::Struct("CGPoint", &[f64::ENCODING, f64::ENCODING]);
+    }
+
+    #[repr(C)]
+    #[derive(Clone, Copy)]
+    struct Rect {
+        origin: Point,
+        size: Size,
+    }
+
+    // SAFETY: a CGPoint then a CGSize, laid out as CGRect.
+    unsafe impl Encode for Rect {
+        const ENCODING: Encoding = Encoding::Struct("CGRect", &[Point::ENCODING, Size::ENCODING]);
+    }
+
+    fn rect([x, y, w, h]: [f64; 4]) -> Rect {
+        Rect { origin: Point { x, y }, size: Size { w, h } }
+    }
+
+    unsafe fn ns(s: &str) -> *mut AnyObject {
+        let c = std::ffi::CString::new(s.replace('\0', "")).unwrap_or_default();
+        unsafe { msg_send![class!(NSString), stringWithUTF8String: c.as_ptr()] }
+    }
+
+    unsafe fn tile() -> *mut AnyObject {
+        unsafe {
+            let app: *mut AnyObject = msg_send![class!(NSApplication), sharedApplication];
+            msg_send![app, dockTile]
+        }
+    }
+
+    pub(super) fn set_badge(label: Option<&str>) {
+        objc2::rc::autoreleasepool(|_| unsafe {
+            let label = label.map_or(std::ptr::null_mut(), |l| ns(l));
+            let _: () = msg_send![tile(), setBadgeLabel: label];
+        });
+    }
+
+    unsafe fn fill(color: *mut AnyObject, bounds: [f64; 4]) {
+        let radius = bounds[3] / 2.0;
+        unsafe {
+            let _: () = msg_send![color, setFill];
+            let path: *mut AnyObject = msg_send![
+                class!(NSBezierPath),
+                bezierPathWithRoundedRect: rect(bounds),
+                xRadius: radius,
+                yRadius: radius
+            ];
+            let _: () = msg_send![path, fill];
+        }
+    }
+
+    pub(super) fn set_progress(fraction: Option<f64>) {
+        objc2::rc::autoreleasepool(|_| unsafe {
+            let tile = tile();
+            let Some(fraction) = fraction else {
+                let _: () = msg_send![tile, setContentView: std::ptr::null_mut::<AnyObject>()];
+                let _: () = msg_send![tile, display];
+                return;
+            };
+            let app: *mut AnyObject = msg_send![class!(NSApplication), sharedApplication];
+            let icon: *mut AnyObject = msg_send![app, applicationIconImage];
+            let side = 128.0;
+            let image: *mut AnyObject = msg_send![class!(NSImage), alloc];
+            let image: *mut AnyObject = msg_send![image, initWithSize: Size { w: side, h: side }];
+            let _: () = msg_send![image, lockFocus];
+            let whole = rect([0.0, 0.0, side, side]);
+            let none = rect([0.0; 4]);
+            // NSCompositingOperationSourceOver
+            let _: () = msg_send![icon, drawInRect: whole, fromRect: none, operation: 2usize, fraction: 1.0f64];
+            let (track, done) = super::bar(side, fraction);
+            fill(msg_send![class!(NSColor), colorWithWhite: 0.0f64, alpha: 0.55f64], track);
+            fill(msg_send![class!(NSColor), systemBlueColor], done);
+            let _: () = msg_send![image, unlockFocus];
+            let view: *mut AnyObject = msg_send![class!(NSImageView), imageViewWithImage: image];
+            let _: () = msg_send![image, release];
+            let _: () = msg_send![tile, setContentView: view];
+            let _: () = msg_send![tile, display];
+        });
+    }
+}
+
+#[cfg(test)]
+#[path = "dock_tests.rs"]
+mod tests;

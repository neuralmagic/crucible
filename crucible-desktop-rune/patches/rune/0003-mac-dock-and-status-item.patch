+use super::{Line, deliver, on_pick};
+
+#[test]
+fn checked_marks_items_and_leaves_other_lines_alone() {
+    assert_eq!(
+        Line::item("a", "Alpha").checked(true),
+        Line::Item { id: "a".into(), title: "Alpha".into(), checked: true }
+    );
+    assert_eq!(Line::Separator.checked(true), Line::Separator);
+    assert_eq!(Line::Label("x".into()).checked(true), Line::Label("x".into()));
+}
+
+#[test]
+fn a_pick_reaches_the_installed_handler_by_id() {
+    let (tx, rx) = std::sync::mpsc::channel();
+    let tx = std::sync::Mutex::new(tx);
+    on_pick(move |id| {
+        let _ = tx.lock().map(|tx| tx.send(id));
+    });
+    deliver("launch:7".into());
+    assert_eq!(rx.recv().unwrap(), "launch:7");
+}

+//! A menu bar extra: one `NSStatusItem` with a title and a menu the app rebuilds whole, whose
+//! picks come back by the id each line was given.
+//!
+//! Call `show` and `hide` on the main thread (from `poll` or a handle update); `on_pick` from
+//! anywhere. Off macOS they do nothing.
+
+use std::sync::{Mutex, OnceLock};
+
+/// One line of the menu.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Line {
+    /// A line the person can pick, reported to `on_pick` by `id`, with a check mark when
+    /// `checked`.
+    Item { id: String, title: String, checked: bool },
+    /// A line that only says something.
+    Label(String),
+    Separator,
+}
+
+impl Line {
+    pub fn item(id: impl Into<String>, title: impl Into<String>) -> Line {
+        Line::Item { id: id.into(), title: title.into(), checked: false }
+    }
+
+    pub fn checked(self, on: bool) -> Line {
+        match self {
+            Line::Item { id, title, .. } => Line::Item { id, title, checked: on },
+            other => other,
+        }
+    }
+}
+
+type Handler = Box<dyn Fn(String) + Send + Sync>;
+
+fn handler() -> &'static Mutex<Option<Handler>> {
+    static HANDLER: OnceLock<Mutex<Option<Handler>>> = OnceLock::new();
+    HANDLER.get_or_init(|| Mutex::new(None))
+}
+
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+fn deliver(id: String) {
+    if let Some(f) = handler().lock().unwrap_or_else(|e| e.into_inner()).as_ref() {
+        f(id);
+    }
+}
+
+/// Calls `f` with the id of every line picked from the menu, on the main thread (wake the app's
+/// loop from it).
+pub fn on_pick(f: impl Fn(String) + Send + Sync + 'static) {
+    *handler().lock().unwrap_or_else(|e| e.into_inner()) = Some(Box::new(f));
+}
+
+/// Puts the status item in the menu bar, if it is not there, titled `title` with `lines` as its
+/// menu.
+#[cfg_attr(not(target_os = "macos"), allow(unused_variables))]
+pub fn show(title: &str, lines: &[Line]) {
+    #[cfg(target_os = "macos")]
+    mac::show(title, lines);
+}
+
+/// Takes the status item out of the menu bar.
+pub fn hide() {
+    #[cfg(target_os = "macos")]
+    mac::hide();
+}
+
+#[cfg(target_os = "macos")]
+mod mac {
+    use std::cell::Cell;
+
+    use objc2::runtime::{AnyClass, AnyObject, ClassBuilder, Sel};
+    use objc2::{class, msg_send, sel};
+
+    use super::Line;
+
+    // NSVariableStatusItemLength
+    const VARIABLE: f64 = -1.0;
+
+    thread_local! {
+        static ITEM: Cell<*mut AnyObject> = const { Cell::new(std::ptr::null_mut()) };
+        static TARGET: Cell<*mut AnyObject> = const { Cell::new(std::ptr::null_mut()) };
+    }
+
+    unsafe fn ns(s: &str) -> *mut AnyObject {
+        let c = std::ffi::CString::new(s.replace('\0', "")).unwrap_or_default();
+        unsafe { msg_send![class!(NSString), stringWithUTF8String: c.as_ptr()] }
+    }
+
+    unsafe fn string(s: *mut AnyObject) -> Option<String> {
+        if s.is_null() {
+            return None;
+        }
+        let utf8: *const std::ffi::c_char = unsafe { msg_send![s, UTF8String] };
+        (!utf8.is_null()).then(|| unsafe { std::ffi::CStr::from_ptr(utf8) }.to_string_lossy().into_owned())
+    }
+
+    extern "C" fn picked(_this: *mut AnyObject, _cmd: Sel, sender: *mut AnyObject) {
+        let id = objc2::rc::autoreleasepool(|_| unsafe { string(msg_send![sender, representedObject]) });
+        if let Some(id) = id {
+            super::deliver(id);
+        }
+    }
+
+    fn target_class() -> &'static AnyClass {
+        const NAME: &str = "RuneMacStatusTarget";
+        if let Some(c) = AnyClass::get(NAME) {
+            return c;
+        }
+        let mut b = ClassBuilder::new(NAME, class!(NSObject)).expect("status target class");
+        unsafe {
+            b.add_method(sel!(picked:), picked as extern "C" fn(_, _, _));
+        }
+        b.register()
+    }
+
+    /// The object menu items send `picked:` to; it lives as long as the process.
+    fn target() -> *mut AnyObject {
+        TARGET.with(|t| {
+            if t.get().is_null() {
+                let made: *mut AnyObject = unsafe { msg_send![target_class(), new] };
+                t.set(made);
+            }
+            t.get()
+        })
+    }
+
+    fn item() -> *mut AnyObject {
+        ITEM.with(|i| {
+            if i.get().is_null() {
+                let made: *mut AnyObject = unsafe {
+                    let bar: *mut AnyObject = msg_send![class!(NSStatusBar), systemStatusBar];
+                    let item: *mut AnyObject = msg_send![bar, statusItemWithLength: VARIABLE];
+                    msg_send![item, retain]
+                };
+                i.set(made);
+            }
+            i.get()
+        })
+    }
+
+    unsafe fn menu(lines: &[Line]) -> *mut AnyObject {
+        unsafe {
+            let menu: *mut AnyObject = msg_send![class!(NSMenu), new];
+            let _: () = msg_send![menu, setAutoenablesItems: false];
+            for line in lines {
+                let entry: *mut AnyObject = match line {
+                    Line::Separator => msg_send![class!(NSMenuItem), separatorItem],
+                    Line::Label(text) => {
+                        let entry: *mut AnyObject = msg_send![class!(NSMenuItem), alloc];
+                        let entry: *mut AnyObject = msg_send![
+                            entry,
+                            initWithTitle: ns(text),
+                            action: Option::<Sel>::None,
+                            keyEquivalent: ns("")
+                        ];
+                        let _: () = msg_send![entry, setEnabled: false];
+                        msg_send![entry, autorelease]
+                    }
+                    Line::Item { id, title, checked } => {
+                        let entry: *mut AnyObject = msg_send![class!(NSMenuItem), alloc];
+                        let entry: *mut AnyObject = msg_send![
+                            entry,
+                            initWithTitle: ns(title),
+                            action: sel!(picked:),
+                            keyEquivalent: ns("")
+                        ];
+                        let _: () = msg_send![entry, setTarget: target()];
+                        let _: () = msg_send![entry, setRepresentedObject: ns(id)];
+                        // NSControlStateValueOn / Off
+                        let _: () = msg_send![entry, setState: if *checked { 1isize } else { 0isize }];
+                        msg_send![entry, autorelease]
+                    }
+                };
+                let _: () = msg_send![menu, addItem: entry];
+            }
+            msg_send![menu, autorelease]
+        }
+    }
+
+    pub(super) fn show(title: &str, lines: &[Line]) {
+        objc2::rc::autoreleasepool(|_| unsafe {
+            let item = item();
+            let button: *mut AnyObject = msg_send![item, button];
+            if !button.is_null() {
+                let _: () = msg_send![button, setTitle: ns(title)];
+            }
+            let _: () = msg_send![item, setMenu: menu(lines)];
+            let _: () = msg_send![item, setVisible: true];
+        });
+    }
+
+    pub(super) fn hide() {
+        ITEM.with(|i| {
+            let item = i.replace(std::ptr::null_mut());
+            if !item.is_null() {
+                unsafe {
+                    let bar: *mut AnyObject = msg_send![class!(NSStatusBar), systemStatusBar];
+                    let _: () = msg_send![bar, removeStatusItem: item];
+                    let _: () = msg_send![item, release];
+                }
+            }
+        });
+    }
+}
+

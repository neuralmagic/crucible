+use super::{bar, clamp};
+
+#[test]
+fn the_bar_fills_its_track_by_the_fraction_and_never_past_it() {
+    let (track, half) = bar(100.0, 0.5);
+    assert_eq!(track[2] / 2.0, half[2]);
+    assert_eq!([track[0], track[1], track[3]], [half[0], half[1], half[3]]);
+    assert_eq!(bar(100.0, 3.0).1[2], track[2]);
+    assert_eq!(bar(100.0, -1.0).1[2], 0.0);
+    assert_eq!(clamp(f64::NAN), 0.0);
+}

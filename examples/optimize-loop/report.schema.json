{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["jobs", "best_job", "speedup"],
  "additionalProperties": false,
  "properties": {
    "jobs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["round", "job", "image", "checksum", "ops_per_s", "p50_ms"],
        "additionalProperties": false,
        "properties": {
          "round": {"type": "integer", "minimum": 0},
          "job": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"},
          "image": {"type": "string", "pattern": "^[^@]+@sha256:[0-9a-f]{64}$"},
          "checksum": {"type": "string"},
          "ops_per_s": {"type": "number"},
          "p50_ms": {"type": "number"},
          "change": {"type": "string"}
        }
      }
    },
    "best_job": {"type": "string"},
    "speedup": {"type": "number"},
    "summary": {"type": "string"}
  }
}
